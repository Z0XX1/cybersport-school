<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cybersport.ViewModels"
             xmlns:models="using:Cybersport.Data.Models"
             x:Class="Cybersport.Views.MainView"
             x:DataType="vm:MainViewModel">
	<UserControl.Styles>
		<Style Selector="TextBox">
			<Setter Property="MinHeight" Value="44"/>
		</Style>

		<Style Selector="Button">
			<Setter Property="MinHeight" Value="44"/>
			<Setter Property="MaxWidth" Value="300"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
		</Style>

		<Style Selector="ComboBox">
			<Setter Property="MinHeight" Value="44"/>
		</Style>

		<Style Selector="CalendarDatePicker">
			<Setter Property="MinHeight" Value="44"/>
		</Style>

		<Style Selector="TimePicker">
			<Setter Property="MinHeight" Value="44"/>
		</Style>

		<Style Selector="CheckBox">
			<Setter Property="MinHeight" Value="44"/>
		</Style>

		<Style Selector="TextBlock">
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>
	</UserControl.Styles>
	<Grid RowDefinitions="Auto,*" Margin="12" RowSpacing="12">
		<StackPanel Grid.Row="0" Spacing="4">
			<TextBlock Text="CyberBoost"
                       FontSize="26"
                       FontWeight="Bold" />
		</StackPanel>
		<TabControl Grid.Row="1">
			<TabItem Header="Ученики">
				<ScrollViewer>
					<StackPanel Spacing="8" Margin="6">
						<TextBlock Text="Список учеников"
								   FontSize="18" FontWeight="Bold"/>
						<ListBox x:Name="StudentsList"
								 Height="180"
								 SelectionChanged="StudentsListSelectionChanged">
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="models:Students">
									<StackPanel Margin="6" Spacing="3">
										<TextBlock Text="{Binding FullName}"
												   FontWeight="Bold"/>
										<TextBlock Text="{Binding Nickname,
                                StringFormat='Ник: {0}'}"/>
										<TextBlock Text="{Binding MainGame,
                                StringFormat='Игра: {0}'}"/>
										<TextBlock Text="{Binding Rank,
                                StringFormat='Ранг: {0}'}"/>
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
						<TextBlock Text="ФИО ученика"/>
						<TextBox x:Name="StudentName"
								 MaxWidth="300"
								 HorizontalAlignment="Stretch"/>
						<TextBlock Text="Никнейм (необязательно)"/>
						<TextBox x:Name="StudentNickname"
								 MaxWidth="300"
								 HorizontalAlignment="Stretch"/>
						<TextBlock Text="Основная игра"/>
						<TextBox x:Name="StudentGame"
								 MaxWidth="300"
								 HorizontalAlignment="Stretch"/>
						<TextBlock Text="Ранг (необязательно)"/>
						<TextBox x:Name="StudentRank"
								 MaxWidth="300"
								 HorizontalAlignment="Stretch"/>
						<TextBlock Text="Дата записи в школу"/>
						<CalendarDatePicker x:Name="StudentDate"
											MaxWidth="300"
											HorizontalAlignment="Stretch"/>
						<StackPanel Orientation="Vertical" Spacing="8">
							<Button Content="Добавить"
									Click="AddStudentClick"/>
							<Button Content="Сохранить"
									Click="SaveStudentClick"/>
							<Button Content="Удалить"
									Click="DeleteStudentClick"/>
						</StackPanel>
						<TextBlock x:Name="StudentMessage"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="Тренеры">
				<ScrollViewer>
					<StackPanel Spacing="8" Margin="6">
						<TextBlock Text="Список тренеров"
								   FontSize="18" FontWeight="Bold"/>
						<ListBox x:Name="CoachesList" Height="180">
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="models:Coaches">
									<StackPanel Margin="6" Spacing="3">
										<TextBlock Text="{Binding FullName}"
												   FontWeight="Bold"/>
										<TextBlock Text="{Binding Game,
                                StringFormat='Игра: {0}'}"/>
										<TextBlock Text="{Binding ExperienceYears,
                                StringFormat='Опыт: {0} лет'}"/>
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
						<TextBlock Text="ФИО тренера"/>
						<TextBox x:Name="CoachName"
								 MaxWidth="300"
								 HorizontalAlignment="Stretch"/>
						<TextBlock Text="Игровая дисциплина"/>
						<TextBox x:Name="CoachGame"
								 MaxWidth="300"
								 HorizontalAlignment="Stretch"/>
						<TextBlock Text="Опыт работы в годах"/>
						<TextBox x:Name="CoachExperience"
								 MaxWidth="300"
								 HorizontalAlignment="Stretch"/>
						<CheckBox x:Name="CoachActive"
								  Content="Работает в школе"/>
						<StackPanel Orientation="Vertical" Spacing="8">
							<Button Content="Добавить"
									Click="AddCoachClick"/>
							<Button Content="Удалить"
									Click="DeleteCoachClick"/>
						</StackPanel>
						<TextBlock x:Name="CoachMessage"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="Занятия">
				<ScrollViewer>
					<StackPanel Spacing="8" Margin="6">
						<TextBlock Text="Список занятий"
								   FontSize="18" FontWeight="Bold"/>
						<ListBox x:Name="LessonsList" Height="180">
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="models:Lessons">
									<StackPanel Margin="6" Spacing="3">
										<TextBlock Text="{Binding StartDate,
                                StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
												   FontWeight="Bold"/>
										<TextBlock Text="{Binding Student.FullName,
                                StringFormat='Ученик: {0}'}"/>
										<TextBlock Text="{Binding Coach.FullName,
                                StringFormat='Тренер: {0}'}"/>
										<TextBlock Text="{Binding DurationMinutes,
                                StringFormat='Длительность: {0} мин'}"/>
									</StackPanel>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
						<TextBlock Text="Выберите ученика"/>
						<ComboBox x:Name="LessonStudent"
								  MaxWidth="300"
								  HorizontalAlignment="Stretch">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="models:Students">
									<TextBlock Text="{Binding FullName}"/>
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
						<TextBlock Text="Выберите тренера"/>
						<ComboBox x:Name="LessonCoach"
								  MaxWidth="300"
								  HorizontalAlignment="Stretch">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="models:Coaches">
									<TextBlock Text="{Binding FullName}"/>
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
						<TextBlock Text="Дата занятия"/>
						<CalendarDatePicker x:Name="LessonDate"
											MaxWidth="300"
											HorizontalAlignment="Stretch"/>
						<TextBlock Text="Время занятия"/>
						<TimePicker x:Name="LessonTime"
									ClockIdentifier="24HourClock"
									MaxWidth="300"
									HorizontalAlignment="Stretch"/>
						<TextBlock Text="Длительность в минутах"/>
						<TextBox x:Name="LessonDuration"
								 MaxWidth="300"
								 HorizontalAlignment="Stretch"/>
						<CheckBox x:Name="LessonCompleted"
								  Content="Занятие проведено"/>
						<StackPanel Orientation="Vertical" Spacing="8">
							<Button Content="Добавить"
									Click="AddLessonClick"/>
							<Button Content="Удалить"
									Click="DeleteLessonClick"/>
						</StackPanel>
						<TextBlock x:Name="LessonMessage"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
		</TabControl>
	</Grid>
</UserControl>